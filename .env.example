# Copy to .env and fill in. Never commit .env (it's gitignored).

# --- Database (required) ---
# The RUNNING APP uses the POOLED connection (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.NEON/DBNAME?sslmode=require"
# MIGRATIONS use the DIRECT connection (host WITHOUT "-pooler"). Pooling can't
# run the migration protocol. Same string, just the non-pooler host.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.NEON/DBNAME?sslmode=require"

# --- Email (required for real magic-link delivery) ---
# Without RESEND_API_KEY the app falls back to on-screen dev links (fine for
# local dev, NOT for public signup).
RESEND_API_KEY=""
# The verified sender. Until you verify your own domain in Resend, you can use
# their shared testing sender: "Jhana <onboarding@resend.dev>".
EMAIL_FROM="Jhana <onboarding@resend.dev>"

# --- App URL (recommended in production) ---
# Absolute base URL used to build magic links in emails. On Vercel this is
# auto-derived from VERCEL_URL if unset, but setting it to your real domain is
# more reliable (e.g. https://jhana.vercel.app).
APP_URL=""
