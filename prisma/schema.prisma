// Jhana — data model
// Four tables, one authorization rule (see design doc §03).
// Role is a property of a *relationship* (Link), not of a User.
// SQLite for local dev; swap `provider`/`url` to postgres to deploy.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  // Auth.js fields. email is provided (verified) by the OAuth provider.
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  // Our own display name (kept for existing UI; seeded from `name`).
  displayName String
  createdAt   DateTime @default(now())

  // Auth.js relations.
  accounts    Account[]
  authSessions Session[]

  // Sits this user logged as the meditator.
  sits               Sit[]
  // Links where this user is the one practicing.
  linksAsMeditator   Link[]    @relation("MeditatorLinks")
  // Links where this user is the teacher/reviewer.
  linksAsFacilitator Link[]    @relation("FacilitatorLinks")
  // Invites this user has sent.
  invitesSent        Invite[]  @relation("InvitesFrom")
}

// --- Auth.js (NextAuth) required models. Managed by @auth/prisma-adapter. ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// A single logged sit — the heart of the app.
// (Renamed from `Session` to avoid colliding with Auth.js's Session model.)
model Sit {
  id          String       @id @default(cuid())
  meditatorId String
  meditator   User         @relation(fields: [meditatorId], references: [id], onDelete: Cascade)

  // When the sit actually happened (may differ from createdAt for a late log).
  occurredAt  DateTime
  // Stored in seconds so short sits (e.g. a 20s test) record honestly.
  durationSec Int

  // --- Structured reflection, all optional and all SHARED with the teacher. ---
  object       String @default("") // what was the object of meditation
  technique    String @default("") // what technique was practiced
  distractions String @default("") // what distractions showed up
  emotions     String @default("") // what emotions arose
  other        String @default("") // anything else

  // Always just for the meditator — the teacher never sees this field.
  privateNotes String @default("")

  // Whether it was timed in-app or logged after the fact.
  source      SitSource @default(timer)

  createdAt   DateTime     @default(now())

  @@index([meditatorId, occurredAt])
}

enum SitSource {
  timer
  manual
}

// The relationship between a meditator and a facilitator.
model Link {
  id            String     @id @default(cuid())
  meditatorId   String
  facilitatorId String
  meditator     User       @relation("MeditatorLinks", fields: [meditatorId], references: [id], onDelete: Cascade)
  facilitator   User       @relation("FacilitatorLinks", fields: [facilitatorId], references: [id], onDelete: Cascade)

  status        LinkStatus @default(pending)
  // Supports the "either side requests" flow; the other party moves status to active.
  requestedBy   LinkRole

  createdAt     DateTime   @default(now())

  // A given pair can only be linked once.
  @@unique([meditatorId, facilitatorId])
}

enum LinkStatus {
  pending
  active
  revoked
}

enum LinkRole {
  meditator
  facilitator
}

// For inviting someone not yet on the platform, via a share link.
// Consumed on signup, then becomes a Link.
model Invite {
  token        String   @id @default(cuid())
  fromUserId   String
  fromUser     User     @relation("InvitesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  // The role the *recipient* will take once they accept.
  intendedRole LinkRole
  expiresAt    DateTime

  createdAt    DateTime @default(now())
}
